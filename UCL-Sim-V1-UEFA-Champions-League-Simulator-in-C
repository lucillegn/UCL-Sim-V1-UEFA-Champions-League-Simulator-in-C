int penaltiserisi(takim userteam, takim rakip)
{
    int userpenalti = 0;
    int rakippenalti_skor = 0;

    printf("\n\n===== PENALTI SERISI =====\n");

    for(int i = 0; i < 5; i++)
    {
        printf("\n--- %d. PENALTI ---\n", i + 1);

        userpenalti += penalti(userteam);

        rakippenalti_skor += rakippenalti(rakip);

        printf("\nPENALTI SKORU: %d - %d\n",
               userpenalti, rakippenalti_skor);
    }

    while(userpenalti == rakippenalti_skor)
    {
        printf("\n--- SERI PENALTI ---\n");

        userpenalti += penalti(userteam);

        rakippenalti_skor += rakippenalti(rakip);

        printf("\nPENALTI SKORU: %d - %d\n",
