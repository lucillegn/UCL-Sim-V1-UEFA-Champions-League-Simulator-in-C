    if(userpenalti > rakippenalti_skor)
    {
        printf("\nPENALTILARLA KAZANDIN!\n");
        return 1;
    }
    else
    {
        printf("\nPENALTILARLA ELENDIN!\n");
        return 0;
    }
}
int tursonucu(takim userteam, takim rakip, int userskor, int rakipskor)
{
    if(userskor > rakipskor)
    {
        printf("\nTuru gectin!\n");
        return 1;
    }
    else if(userskor == rakipskor)
    {
        printf("\nSkorlar esit! Penaltilar...\n");

        if(penaltiserisi(userteam, rakip))
        {
            printf("Penaltilarla turu gectin!\n");
            return 1;
        }
        else
        {
            printf("Penaltilarla elendin!\n");
            return 0;
        }
    }
    else
    {
        printf("\nElendin!\n");
        return 0;
    }
}
takim rakipsec(UCL allpot[], int *allpotize, takim userteam)
{
    int random;
    takim rakip;

    do
    {
        random = rand() % *allpotize;
        rakip = allpot[random].team;

    }while(strcmp(userteam.isim, rakip.isim) == 0);


    for(int i = random; i < *allpotize - 1; i++)
    {
        allpot[i] = allpot[i + 1];
    }

    (*allpotize)--;

    return rakip;
}


