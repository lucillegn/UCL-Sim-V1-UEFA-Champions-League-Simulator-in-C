int golhesapla(double lambda)
{
    double olasilik = (double)rand() / RAND_MAX;
    double toplam = exp(-lambda);

    int k = 0;
    double terim = toplam;

    while(olasilik > toplam)
    {
        k++;

        terim *= lambda / k;
        toplam += terim;
    }

    return k;
}
